DATABASE_URL=postgresql+psycopg://agrivalue:CHANGE_ME@localhost:5432/agrivalue
# Generate separate random secrets; see README.md. Never commit .env.
JWT_SECRET=
LOOKUP_SECRET=
ENCRYPTION_KEY=
ENVIRONMENT=development
# Explicit demo mode: OTP returned in the response, never logged. Forbidden in production.
SMS_MODE=demo
# Production SMS adapter: HTTPS endpoint accepting {phone, otp, expires_in_seconds}.
SMS_URL=
SMS_TOKEN=
# Required pilot settings; no district values are assumed.
PILOT_DISTRICTS=[]
# Development only: an empty district list enables manual district entry.
# Object keyed by crop code. Each entry: active, bag_weight_kg, varieties, grades,
# and optional high_quantity_qtl_per_acre. Do not use illustrative FSD values as real defaults.
CROPS={}
# Development only: empty CROPS uses app/development_crops.json for dropdowns.
# These generic variety and grade labels are for development, not grading standards.
MAX_FARM_ACRES=100
MAX_STORAGE_MONTHS=6
OTP_RESEND_SECONDS=60
